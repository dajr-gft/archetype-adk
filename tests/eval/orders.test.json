            "role": "model",
            "parts": [{ "text": "Order 000101 is cancelled." }]
          },
          "intermediate_data": {
            "tool_uses": [{ "name": "submit_order_cancellation", "args": {} }],
            "intermediate_responses": []
          }
        }
      ],
      "session_input": { "app_name": "domain_agent", "user_id": "ana", "state": {} }
    },
