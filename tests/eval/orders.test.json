{
  "eval_set_id": "orders_agent_golden",
  "name": "orders agent - golden tool trajectories",
  "description": "Regression gate of the illustrative orders domain. With tool_trajectory_avg_score = 1.0 (test_config.json) a wrong, missing, extra or reordered tool call fails. A generated agent replaces these cases with the conversations of its own domain.",
  "eval_cases": [
    {
      "eval_id": "lookup_by_id",
      "conversation": [
        {
          "invocation_id": "lookup-1",
          "user_content": {
            "role": "user",
            "parts": [{ "text": "What is the status of order 103?" }]
          },
          "final_response": {
            "role": "model",
            "parts": [{ "text": "Order 000103 of NORTHWIND TRADING is SHIPPED." }]
          },
          "intermediate_data": {
            "tool_uses": [{ "name": "find_order", "args": { "query": "103" } }],
            "intermediate_responses": []
          }
        }
      ],
      "session_input": { "app_name": "domain_agent", "user_id": "ana", "state": {} }
    },
    {
