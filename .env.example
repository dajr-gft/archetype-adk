# Backend: Gemini on Vertex AI (Gemini Enterprise Agent Platform).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
# `global` serves the newest models. A regional endpoint (data residency) serves fewer
# versions: check with `python tools/check_model.py` before choosing.
GOOGLE_CLOUD_LOCATION=global

# The model the agent uses. Leave unset for the default of domain_agent/agent.py.
# AGENT_MODEL=gemini-3.8-flash

# Sampling temperature (default 0.0). Change it only if the model card asks for it, and
# run the evaluation gate afterwards.
# AGENT_TEMPERATURE=0.0

# Seconds a use case may take before the tool answers that the outcome is unknown.
# USE_CASE_TIMEOUT_SECONDS=30

# Alternative backend: Gemini API key (local experiments only).
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GEMINI_API_KEY=your-api-key

# Telemetry: ADK puts tool arguments and results in trace spans unless this is false.
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT

# Skips the evaluation gate on purpose when no backend is available (it fails otherwise).
# EVAL_GATE=off
